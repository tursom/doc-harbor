---
import '../styles.css'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <title>{title === 'DocHarbor' ? title : `${title} · DocHarbor`}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
